{"/": "Welcome to RASH's filesystem! This is the root directory. You can use the 'ls' command to list files and directories, 'cd <directory>' to change directories, and 'cat <file>' to view file contents.", "/boot/boot.py": "# RASH-0.1 OS EDITION\n\nimport io\nimport builtins\nimport math\nimport urllib.request\nfrom urllib.request import Request, urlopen\nfrom urllib.error import URLError, HTTPError\nimport time\nimport shutil\n\ndef check_url_exists(url, timeout=5):\n    req = Request(url, method='HEAD')\n    \n    req.add_header('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)')\n    \n    try:\n        with urlopen(req, timeout=timeout) as response:\n            return response.status < 400\n    except HTTPError as e:\n        print(f\"HTTP Error: {e.code}\")\n        return False\n    except URLError as e:\n        print(f\"URL Error: {e.reason}\")\n        return False\n    except Exception as e:\n        print(f\"Other Error: {e}\")\n        return False\n\n\nPAOKET = \"https://raw.githubusercontent.com/neel902/RASH-Paoket/refs/heads/main/packages/\"\n\ndef col_print(lines, term_width=None, indent=0, pad=2):\n    \"\"\"Print list of strings in multiple columns\n    Original: https://gist.github.com/critiqjo/2ca84db26daaeb1715e1\n    Adjusted: https://gist.github.com/Nachtalb/8a85c0793b4bea0a102b7414be5888d4\n    \"\"\"\n    if not term_width:\n        size = shutil.get_terminal_size((80, 20))\n        term_width = size.columns\n\n    n_lines = len(lines)\n    if n_lines == 0:\n        return\n\n    col_width = max(len(line) for line in lines)\n    n_cols = int((term_width + pad - indent) / (col_width + pad))\n    n_cols = min(n_lines, max(1, n_cols))\n\n    col_len = int(n_lines / n_cols) + (0 if n_lines % n_cols == 0 else 1)\n    if (n_cols - 1) * col_len >= n_lines:\n        n_cols -= 1\n\n    cols = [lines[i * col_len: i * col_len + col_len] for i in range(n_cols)]\n\n    rows = list(zip(*cols))\n    rows_missed = zip(*[col[len(rows):] for col in cols[:-1]])\n    rows.extend(rows_missed)\n\n    for row in rows:\n        printf(\" \" * indent + (\" \" * pad).join(line.ljust(col_width) for line in row))\n\n\ndef pull_url(url):\n    try:\n        with urllib.request.urlopen(urllib.request.Request(url + f\"?t={int(time.time())}\")) as response:\n            file_contents = response.read().decode('utf-8')\n        return file_contents\n    except Exception as e:\n        raise UsrError(str(e))\n\ndef base64(num):\n    BASE64_ALPHABET = \" !\\\"#\\\\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_abcdefghijklmnopqrstuvwxyz{|}~`00000000\"\n    if num == 0:\n        return BASE64_ALPHABET[0]\n    \n    arr = []\n    base = 99\n    while num:\n        num, rem = divmod(num, base)\n        arr.append(BASE64_ALPHABET[rem])\n        \n    return ''.join(reversed(arr))\ndef base10(b64_str):\n    BASE64_ALPHABET = \" !\\\"#\\\\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\\\]^_abcdefghijklmnopqrstuvwxyz{|}~`00000000\"\n    CHAR_TO_INDEX = {char: index for index, char in enumerate(BASE64_ALPHABET)}\n    num = 0\n    for char in b64_str:\n        num = num * 99 + CHAR_TO_INDEX[char]\n    return num\n\ndef printf(*args, end2=\"\\n\"):\n    \"\"\"Prints to the console.\"\"\"\n    print(*args, end=end2)\n\ndef printe(msg):\n    \"\"\"Prints as an error message to the console.\"\"\"\n    print(\"\\033[91m\" + msg + \"\\033[0m\")\n\nclass UsrError(Exception):\n    \"\"\"Custom exception for user errors.\"\"\"\n    pass\n\nPASSWORD = \"rash2026\"\nUSR = \"rashuser\"\n\nWELCOME_MSG = \"\\x1b[1;34;44m\"+r\"\"\"\n _    _  ____  __    ___  _____  __  __  ____    ____  _____        \n( \\/\\/ )( ___)(  )  / __)(  _  )(  \\/  )( ___)  (_  _)(  _  )       \n )    (  )__)  )(__( (__  )(_)(  )    (  )__)     )(   )(_)(        \n(__/\\__)(____)(____)\\___)(_____)(_/\\/\\_)(____)   (__) (_____)       \n ____    __    ___  _   _       ___  __    ___   ___  ___    _      \n(  _ \\  /__\\  / __)( )_( )___  / _ \\/  )  (__ \\ / _ \\(__ \\  / )     \n )   / /(__)\\ \\__ \\ ) _ ((___)( (_) ))(    / _/( (_) )/ _/ / _ \\    \n(_)\\_)(__)(__)(___/(_) (_)     \\___/(__)  (____)\\___/(____)\\___/    \nRiverCape Advanced Shell for the RSIE (OS Edition)\n\"\"\"+\"\\033[0m\"\n\nMEMORY = 8192\n\nPERMS = False\n\nCURR_DIR = \"/\"\n\nclass ROM:\n    def paoket(flags, ram):\n        if len(flags) > 0:\n            url = PAOKET + (flags[0] if flags[0].endswith(\".py\") else flags[0] + \".py\")\n            package_path = PAOKET + (flags[0] if flags[0].endswith(\".py\") else flags[0] + \".py\") + \".meta\"\n            pckgmeta = pull_url(package_path)\n            #print(pckgmeta)\n            metadata = {}\n            exec(pckgmeta, globals=metadata)\n            pckgloc = metadata[\"location\"]\n            pckgloc2 = metadata[\"otherloc\"]\n            pckver = metadata[\"version\"]\n            metadata.clear()\n            printf(f\"Installing {flags[0].replace(\".py\", \"\")}-{pckver}\")\n            pack = pull_url(url)\n            FileAPI.set_file(pckgloc, pack)\n            for loc in pckgloc2:\n                FileAPI.set_file(loc, \"Welcome! (Auto generated by paoket)\")\n\n            FileAPI.set_file(\"/paoket/packages/packages.txt\", (FileAPI.get_file(\"/paoket/packages/packages.txt\") if FileAPI.file_exists(\"/paoket/packages/packages.txt\") else \"\") + f\"\\n{flags[0].replace(\".py\", \"\")} | {pckver} | {package_path}\")\n            printf(f\"Finished installing {flags[0].replace(\".py\", \"\")}-{pckver}\")\n        else:\n            if not FileAPI.file_exists(\"/paoket/packages/packages.txt\"):\n                printf(\"No packages installed or malformed packages.txt\")\n            else:\n                package_list = FileAPI.get_file(\"/paoket/packages/packages.txt\").split(\"\\n\")\n                packages = []\n                for line in package_list:\n                    if line.strip() == \"\":\n                        continue\n                    else:\n                        packages.append(line.split(\"|\")[0].strip() + \"-\" + line.split(\"|\")[1].strip())\n                col_print(packages)\n        return ram\n    def paoketinfo(flags, ram):\n        if len(flags) > 0:\n            url = PAOKET + (flags[0] if flags[0].endswith(\".py\") else flags[0] + \".py\") + \".txt\"\n            print(pull_url(url))\n        return ram\n    def ed(flags, ram):\n        if len(flags) > 0:\n            file = (CURR_DIR + flags[0][1:]) if flags[0].startswith(\"/\") else (CURR_DIR + flags[0])\n            contents = FileAPI.get_file(file)\n            app = FileEd.create_editor_app(initial_text=contents, file_name=file if \".\" in file else file + \".txt\")\n            FileAPI.set_file(file, app.run())\n            printf(\"Finished ed command\")\n        else:\n            raise UsrError(\"Note nough arguments for ed command\")\n        return ram\n    def read(flags, ram):\n        if len(flags) > 0:\n            printf(FileAPI.get_file(((CURR_DIR + flags[0][1:]) if flags[0].startswith(\"/\") else (CURR_DIR + flags[0]))))\n            \"\"\"addr = int(flags[0])\n            if 0 <= addr < MEMORY:\n                printf(base64(ram[addr]) if \"--text\" in flags else ram[addr])\n            else:\n                raise UsrError(f\"Address {addr} is out of bounds (0-{MEMORY-1})\")\"\"\"\n        else:\n            raise UsrError(\"Not enough arguments for read command\")\n        return ram\n    def rm(flags, ram):\n        if len(flags) > 0:\n            if input(f\"Are you sure you want to delete {(((CURR_DIR + flags[0][1:]) if flags[0].startswith(\"/\") else (CURR_DIR + flags[0])))}? This action cannot be undone. Type 'yes' to confirm: \") == 'yes':\n                FileAPI.delete_file(((CURR_DIR + flags[0][1:]) if flags[0].startswith(\"/\") else (CURR_DIR + flags[0])))\n            else:\n                printf(\"Operation cancelled\")\n        else:\n            raise UsrError(\"Not enough arguments for remove command\")\n        return ram\n    def write(flags, ram):\n        printe(\"Warning: The 'write' command is deprecated. Please use 'ed' or 'edit'. No file changes have been made.\")\n        return ram\n        if len(flags) > 1:\n            printe(\"Warning: The 'write' command is deprecated. Please use 'ed' or 'edit'. No file changes have been made.\")\n            #FileAPI.set_file(CURR_DIR + flags[0][1:] if flags[0].startswith(\"/\") else (CURR_DIR + flags[0]), \" \".join(flags[1:]))\n            \"\"\"addr = int(flags[0])\n            value = int(base10(\" \".join(flag for flag in flags[1:] if not flag.startswith(\"--\")))) if \"--text\" in flags else flags[1]\n            if 0 <= addr < MEMORY:\n                ram[addr] = value\n            else:\n                raise UsrError(f\"Address {addr} is out of bounds (0-{MEMORY-1})\")\"\"\"\n        else:\n            raise UsrError(\"Not enough arguments for write command\")\n        return ram\n    def cd(flags, ram):\n        global CURR_DIR\n        if len(flags) > 0:\n            new_dir = flags[0]\n            if new_dir.startswith(\"/\"):\n                CURR_DIR = new_dir\n            else:\n                CURR_DIR = CURR_DIR.rstrip(\"/\") + \"/\" + new_dir\n            if not CURR_DIR.endswith(\"/\"):\n                CURR_DIR += \"/\"\n        else:\n            raise UsrError(\"Not enough arguments for cd command\")\n        return ram\n    def current_directory(flags, ram):\n        printf(CURR_DIR)\n        return ram\n    def ls(flags, ram):\n        if len(flags) > 0:\n            dir_path = flags[0]\n            if not dir_path.startswith(\"/\"):\n                dir_path = CURR_DIR.rstrip(\"/\") + \"/\" + dir_path\n        else:\n            dir_path = CURR_DIR\n        \n        content = FileAPI.list_files_in_directory(dir_path)\n        if content is not None:\n            col_print(content)\n        else:\n            raise UsrError(f\"Directory {dir_path} does not exist\")\n        \n        return ram\n    def testconsole(flags, ram):\n        printf(\"Message test\")\n        return ram\n    def help(flags, ram):\n        if len(flags) > 0:\n            command = flags[0]\n            if command == \"exit\":\n                printf(\"Exits the program. Usage: exit\")\n            elif command == \"sjelter\":\n                printf(\"Sjelter? Usage: sjelter\")\n            elif command in ROM.alias:\n                printf(ROM.helpmsg[ROM.alias[command]])\n                # Add more detailed help for each command as needed\n            else:\n                raise UsrError(f\"No help available for unknown command '{command}'\")\n        else:\n            printf(\"Available commands:\")\n            col_print((list(ROM.pin.keys())) + [\"exit\", \"sjelter\"])\n            printf(\"\\nType 'help <command>' for more details on a specific command.\")\n        return ram\n    def clearconsole(flags, ram):\n        printf(\"\\033[2J\\033[3J\\033[H\")  # ANSI escape code to clear the console\n        return ram\n    def aliases(flags, ram):\n        command = flags[0] if len(flags) > 0 else None\n        if command in ROM.alias.keys():\n            printf(f\"Alias for '{command}': {', '.join([key for key, value in ROM.alias.items() if value == ROM.alias[command]])}\")\n        else:\n            printf(f\"No alias found for '{command}'\")\n        return ram\n    def echo(flags, ram):\n        printf(\" \".join(flags))\n        return ram\n    def typeCONSOLEVER(flags, ram):\n        if len(flags) > 0:\n            if flags[0] == \"exit\":\n                printf(\"Command 'exit' is a built-in command.\")\n            elif flags[0] == \"sjelter\":\n                printf(\"Sjelter? Command 'sjelter' is a built-in command.\")\n            elif flags[0] in ROM.alias:\n                printf(f\"Command '{flags[0]}' is an alias for '{ROM.alias[flags[0]]}'.\")\n            else:\n                printf(f\"Command '{flags[0]}' is not recognized.\")\n        else:\n            raise UsrError(\"Not enough arguments for type command\")\n        return ram\n    def math(flags, ram):\n        if len(flags) > 0:\n            try:\n                expression = \" \".join(flags)\n                result = eval(expression, {\"__builtins__\": None}, {\"math\": math})\n                printf(f\"Result: {result}\")\n            except Exception as e:\n                raise UsrError(f\"Error evaluating expression: {e}\")\n        else:\n            raise UsrError(\"Not enough arguments for math command\")\n        return ram\n    def pythonCONSOLEVER(flags, ram):\n        oldram = ram.copy()\n        variables = {}\n        \n        class rash:\n            def __init__(self):\n                printf(\"RASH Python console. Use rash.merge(address, value) to write to memory, rash.get(address) to read from memory, and rash.rollback() to revert changes.\")\n            def merge(adr,val):\n                ram[int(adr)] = val\n            def get(adr):\n                return ram[int(adr)]\n            def rollback():\n                nonlocal ram\n                ram = oldram.copy()\n        class rashFS:\n            def read(path):\n                return FileAPI.get_file(path)\n            def write(path, value):\n                FileAPI.set_file(path, value)\n            def delete(path):\n                FileAPI.delete_file(path)\n    \n\n        def openOVERRIDE(path, type):\n            printe(\"Do not use 'open' in the RASH terminal. Instead, use rashFS.\")\n            return io.StringIO(FileAPI.get_file(path))\n        \n        variables['rash'] = rash\n        variables['open'] = openOVERRIDE\n        variables['rashFS'] = rashFS\n        if len(flags) == 0:\n            \n            running2 = True\n            print(\"Entering Python console. Type 'exit()' to return to the main console. This will not stop RASH.\")\n            while running2:\n                try:\n                    user_input2 = input(\"Python> \")\n                    if user_input2.lower() == 'exit()':\n                        running2 = False\n                        printf(\"Exiting Python console...\")\n                    else:\n                        exec(user_input2, globals=variables)\n                except Exception as e:\n                    printe(f\"Error: {e}\")\n        else:\n            code = FileAPI.get_file(((CURR_DIR + flags[0][1:]) if flags[0].startswith(\"/\") else (CURR_DIR + flags[0])))\n            if code == \"\\033[91mUNKNOWN FILE\\033[0m\": raise UsrError(\"Unknown / invalid python file\")\n            exec(code,globals=variables)\n        return ram\n    def sudo(flags, ram):\n        if (flags) == ([\"rm\", \"rf\", \"--no-preserve-root\", \"/\"]):\n            raise UsrError(\"Uninstalling french language pack... Please do not attempt to delete root directory during this process.\")\n        elif (flags) == ([\"rm\", \"rf\", \"/\"]):\n            raise UsrError(\"Use --no-preserve-root to uninstall french language pack. Please do not attempt to delete root directory during this process.\")\n        elif len(flags) > 0:\n            password = flags[0]\n            global PASSWORD\n            global PERMS\n            if password == PASSWORD:\n                printf(\"\\033[F\\033[KPassword Hidden\\nPermissions succesfully elevated.\" if not PERMS else \"\\033[F\\033[KPassword Hidden\\nPermissions already elevated.\")\n                PERMS = True\n            elif password == \"password\" and PERMS:\n                if len(flags) > 1 and flags[1] == \"reset\":\n                    PASSWORD = \"rash2026\"\n                if len(flags) > 1 and flags[1] == \"get\":\n                    printf(f\"Current password: {PASSWORD}\")\n                if len(flags) > 2 and flags[1] == \"set\":\n                    PASSWORD = flags[2]\n            elif password == \"off\":\n                printf(\"Permissions succesfully revoked.\" if PERMS else \"Permissions already revoked.\")\n                PERMS = False\n            else:\n                raise UsrError(\"Incorrect password for sudo command\")\n        else:\n            raise UsrError(\"Not enough arguments for sudo command\")\n\n        return ram\n    def rashfetch(flags, ram):\n        T1=r\"\"\"\n\u001b[2;34m         _       \u001b[0m\n\u001b[2;34m        /\\ \\     \u001b[0m\n\u001b[2;34m       /  \\ \\    \u001b[0m\n\u001b[2;34m      / /\\ \\ \\   \u001b[0m\n\u001b[2;34m     / / /\\ \\ \\  \u001b[0m\n\u001b[2;34m    / / /  \\ \\_\\ \u001b[0m\n\u001b[2;34m   / / /   / / / \u001b[0m\n\u001b[2;34m  / / /   / / /  \u001b[0m\n\u001b[2;34m / / /___/ / /   \u001b[0m\n\u001b[2;34m/ / /____\\/ /    \u001b[0m\n\u001b[2;34m\\/_________/     \u001b[0m\n                 \n                 \n                 \n                 \n                 \n                 \n\n\"\"\"\n        T2 = (\"\"\"\n\u001b[2;34m\u001b[1;34m   ___    _    ___  _ __     _    _\n\u001b[2;34m\u001b[1;34m  / o | .' \\ ,' _/ /// /   ,' \\ ,'/\u001b[0m\u001b[2;34m\n\u001b[2;34m\u001b[1;34m /  ,' / o /_\\ `. / ` /___/ 0 / // \u001b[0m\u001b[2;34m\n\u001b[2;34m\u001b[1;34m/_/`_\\/_n_//___,'/_n_//__/\\_,' //  \u001b[0m\u001b[2;34m\n                                   \u001b[0m\n\n\u001b[2;34m\u001b[0m\u001b[1;2m\u001b[1;34mTerminal:\u001b[0m \u001b[0m       Rash Integrated Terminal\u001b[1;2m\u001b[1;34m\u001b[0m\n\u001b[2;34m\u001b[0m\u001b[1;2m\u001b[1;34mShell:\u001b[0m\u001b[0m\u001b[2;34m \u001b[0m          RASH-01\u001b[0m\n\u001b[2;34m\u001b[1;34m\u001b[1;34mRAM Usage:\u001b[0m\u001b[1;34m\u001b[0m\u001b[2;34m \u001b[0m      ${1}kb/${2}kb\u001b[0m\n\u001b[1;2m\u001b[1;34mOS:\u001b[0m\u001b[0m\u001b[2;34m\u001b[0m              Rash Sandboxing Interface Extended (RSIE)\u001b[0m\n\u001b[2;34m\u001b[0m\u001b[1;2m\u001b[1;34mKernel:\u001b[0m\u001b[0m          Rash Sandboxing Interface Extended (RSIE)\u001b[2;34m\u001b[0m\n\u001b[0m\u001b[1;2m\u001b[1;34mUser: \u001b[0m\u001b[0m           rash2026\u001b[2;34m\u001b[0m\n\u001b[0m\u001b[1;2m\u001b[1;34mCPU: \u001b[0m\u001b[0m            Rash Sandboxing Interface Extended (RSIE)\u001b[0m\n\u001b[2;34m\u001b[0m\u001b[1;2m\u001b[1;34mGPU:\u001b[0m\u001b[0m             Rash Sandboxing Interface Extended (RSIE)\u001b[0m\n\"\"\".replace(\"${1}\", str(sum(1/1024 for x in ram if x != 0))).replace(\"${2}\", str(MEMORY/1024)))\n        T = (t1+t2 for t1,t2 in zip(T1.splitlines(),T2.splitlines()))\n        printf(\"\\n\".join(T))\n\n        return ram\n    def format(flags, ram):\n        if len(flags) > 0:\n            if flags[0] == \"drive\":\n                if input(\"Are you sure you want to format the drive? This will erase all data. Type 'yes' to confirm: \") == \"yes\":\n                    FileAPI.format_drive()\n                    global CURR_DIR\n                    CURR_DIR = \"/\"\n                    printf(\"Drive formatted successfully.\")\n                else:\n                    printf(\"Format operation cancelled.\")\n            else:\n                raise UsrError(f\"Unknown format target '{flags[0]}'. Currently, only 'drive' is supported.\")\n        else:\n            raise UsrError(\"Not enough arguments for format command\")\n        return ram\n    def drive_details(flags, ram):\n        printf(\"\\n\".join(f\"{list(FileAPI.drive_details().keys())[j]:15}|{FileAPI.drive_details()[list(FileAPI.drive_details().keys())[j]]:>15}\" for j in range(len(FileAPI.drive_details().items()))))\n        return ram\n    def create(flags, ram):\n        FileAPI.set_file(CURR_DIR + flags[0][1:] if flags[0].startswith(\"/\") else (CURR_DIR + flags[0]), \"Welcome\")\n        return ram\n    def run(flags, ram):\n        if len(flags) > 0:\n            path = \"/paoket/packages/\" + flags[0] + (\"\" if flags[0].endswith(\".py\") else \".py\")\n            if FileAPI.file_exists(path):\n                oldram = ram.copy()\n                variables = {}\n                \n                class rash:\n                    def __init__(self):\n                        printf(\"RASH Python console. Use rash.merge(address, value) to write to memory, rash.get(address) to read from memory, and rash.rollback() to revert changes.\")\n                    def merge(adr,val):\n                        nonlocal ram\n                        ram[int(adr)] = val\n                    def get(adr):\n                        return ram[int(adr)]\n                    def rollback():\n                        nonlocal ram\n                        ram = oldram.copy()\n                class rashFS:\n                    def read(path):\n                        return FileAPI.get_file(path)\n                    def write(path, value):\n                        FileAPI.set_file(path, value)\n                    def delete(path):\n                        FileAPI.delete_file(path)\n                \n                \n                def openOVERRIDE(path, type):\n                    printe(\"Error in package: Message: Do not use 'open' in the RASH terminal. Instead, use rashFS. Please contact the package owner to change this.\")\n                    return io.StringIO(FileAPI.get_file(path))\n                \n                variables['rash'] = rash\n                variables['open'] = openOVERRIDE\n                variables['rashFS'] = rashFS\n                \n                code = FileAPI.get_file(path)\n                exec(code,globals=variables)\n            else:\n                url = PAOKET + (flags[0] if flags[0].endswith(\".py\") else flags[0] + \".py\")\n                exists = check_url_exists(url)\n                raise UsrError(f\"Package {flags[0]} does not exist, but can be downloaded with paoket {flags[0]}.\" if exists else f\"Package {flags[0]} does not exist.\")\n        else:\n            raise UsrError(\"Not enough arguments for run command\")\n        return ram\n    def paoketupdate(flags, ram):\n        if not FileAPI.file_exists(\"/paoket/packages/packages.txt\"):\n            raise (UsrError(\"No packages to update or malformed packages.txt file.\"))\n        else:\n            package_list = FileAPI.get_file(\"/paoket/packages/packages.txt\").split(\"\\n\")\n            newfile = \"\"\n            for line in package_list:\n                if line.strip() == \"\":\n                    continue\n                else:\n                    lines = line.strip().split(\"|\")\n                    if len(lines) < 3 : raise UsrError(\"Malformed packages.txt file.\")\n                    printf(f\"Found existing package {lines[0].strip()} on version {lines[1].strip()}. Checking for updates...\")\n                    pckgmeta = pull_url(lines[2])\n                    metadata = {}\n                    exec(pckgmeta, globals=metadata)\n                    pckgloc = metadata[\"location\"]\n                    pckgloc2 = metadata[\"otherloc\"]\n                    pckver = metadata[\"version\"]\n                    metadata.clear()\n                    if pckver.strip() == lines[1].strip():\n                        printf(\"No updates found. Continuing.\")\n                        newfile += line + \"\\n\"\n                        continue\n                    else:\n                        printf(f\"New version found: {pckver}. Installing... [....]\", end2=\"\")\n                        url = lines[2].strip().removesuffix(\".meta\")\n                        package = pull_url(url)\n                        FileAPI.set_file(pckgloc, package)\n                        for loc in pckgloc2:\n                            FileAPI.set_file(loc, \"Welcome! (Auto generated by paoket)\")\n            \n                        newfile += f\"\\n{lines[0].strip()} | {pckver} | {lines[2].strip()}\"\n                        printf(f\"\\rNew version found: {pckver}. Installing... [\\033[32mDONE\\033[0m]\")\n            FileAPI.set_file(\"/paoket/packages/packages.txt\", newfile)\n        return ram\n\n    NEEDS_ELEVATED_PERMS = [\"python\", \"format\", \"rm\", \"ed\", \"paoket\"]\n    pin = {\n        \"read\": re