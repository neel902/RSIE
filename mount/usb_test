{"/boot.py": "\nimport urllib.request\nimport time\nimport hashlib\n\ndef pull_url(url):\n    with urllib.request.urlopen(urllib.request.Request(url + f\"?t={int(time.time())}\")) as response:\n        file_contents = response.read().decode('utf-8')\n    return file_contents\n\nprint(\"Welcome to the Rash installer for the RSIE!\")\nprint(\"\")\nif input(\"To start the installation, enter 'y'. To cancel, just press enter without entering anything, use a valid keyboard escape or close this terminal. No changes have been made to the drive.\") == \"y\":\n    print(\"Starting Rash configuration\")\n    print(\"\")\n    if input(\"Would you like to wipe the drive before installing Rash? (This will also reset BIOS options) (y) \") == \"y\":\n        FileAPI.format_drive()\n    print(\"Installing Rash...\")\n    print(\"\")\n\n    while True:\n        print(\"Fetching install...\")\n\n        rashcode = pull_url(\"https://github.com/neel902/RASH/releases/download/RSIERash/rash_rsie.py\")\n        shaog = \"4ffaa6b51799d0c98fd39e85d3d827b091538dab5f83f46d50aaf23abc86f733\"\n        \n        print(\"Found and fetched RASH install\")\n        print(\"\")\n        print(\"Checking SHA256\")\n        print(f\"Target SHA256:     {shaog}\")\n\n        sha256_hash = hashlib.sha256(rashcode.encode('utf-8')).hexdigest()\n        print(f\"Calculated SHA256: {sha256_hash}\")\n\n        if shaog == sha256_hash:\n            print(\"Checksum success\")\n            break\n        else:\n            print(\"Checksum failed; trying again\")\n    \n    print(\"\")\n    print(\"Downloading to drive...\")\n    FileAPI.set_file(\"/boot/boot.py\", rashcode)    \n    print(\"\")\n    print(\"Succesfully installed Rash\")\n    input(\"Press enter to finish\")\nelse:\n    print(\"Cancelling install...\")\n"}